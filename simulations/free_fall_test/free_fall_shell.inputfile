# Free fall simulation for N=12 shell
scheme deterministic_adams_bashforth
domain no_wall
mobility_blobs_implementation python_no_wall
mobility_vector_prod_implementation python_no_wall
blob_blob_force_implementation None
dt 0.05
n_steps 20
n_save 1
eta 1.0
g 1.0
blob_radius 0.25
repulsion_strength 0.0
debye_length 1.0
repulsion_strength_wall 0.0
debye_length_wall 1.0
save_clones one_file
output_name c:/MTP-oct/simulations/free_fall_test/free_fall_shell
structure c:/MTP-oct/RigidMultiblobsWall/multi_bodies/Structures/shell_N_12_Rg_1_Rh_1_2625.vertex c:/MTP-oct/RigidMultiblobsWall/multi_bodies/Structures/shell_N_12_Rg_1.clones
